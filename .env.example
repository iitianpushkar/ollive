# Database
POSTGRES_USER=ollive
POSTGRES_PASSWORD=ollive_secret
POSTGRES_DB=ollive
DATABASE_URL=postgresql://ollive:ollive_secret@localhost:5432/ollive

# Redis (event bus)
REDIS_URL=redis://localhost:6379

# Ingestion service
INGESTION_URL=http://localhost:8001
INGESTION_API_KEY=dev-ingestion-key
PORT_INGESTION=8001

# Chatbot service
CHATBOT_URL=http://localhost:8000
PORT_CHATBOT=8000
DEFAULT_MODEL=openai/gpt-4o-mini
CORS_ORIGIN=http://localhost:3000

# OpenRouter (single gateway for all models)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Ollive

# SDK
OLLIVE_LOG_PREVIEW_CHARS=500
OLLIVE_PII_REDACTION=true

# Next.js
NEXT_PUBLIC_CHATBOT_URL=http://localhost:8000
NEXT_PUBLIC_INGESTION_URL=http://localhost:8001
